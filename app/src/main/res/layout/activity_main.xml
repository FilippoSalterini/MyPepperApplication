<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="#0D0F14">

        <!-- ── Top bar: status ───────────────────────────────────────── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#161920"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:elevation="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/app_name"
                    android:textColor="#00E5A0"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.12" />

                <TextView
                    android:id="@+id/tvStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/idle"
                    android:textColor="#6B7280"
                    android:textSize="11sp" />

                <!-- Status dot: semplice cerchio colorato via codice, no drawable esterno -->
                <View
                    android:id="@+id/viewStatusDot"
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:layout_marginStart="8dp"
                    android:background="@android:color/darker_gray" />

            </LinearLayout>

            <!-- Warning banner -->
            <TextView
                android:id="@+id/tvWarning"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="#1AFFF3CD"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:text="@string/if_the_controls_do_not_respond_exit_the_app_and_re_enter"
                android:textColor="#856404"
                android:textSize="11sp"
                android:gravity="center"
                android:visibility="visible" />

        </LinearLayout>

        <!-- ── Conversation area ─────────────────────────────────────── -->
        <ScrollView
            android:id="@+id/scrollConversation"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:fillViewport="false"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/llConversation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp" />

        </ScrollView>

        <!-- ── Bottom bar: controls ──────────────────────────────────── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#161920"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="12dp"
            android:paddingBottom="16dp"
            android:elevation="4dp">

            <!-- Object spinner row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="10dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="10dp"
                    android:text="@string/object"
                    android:textColor="#6B7280"
                    android:textSize="11sp" />

                <Spinner
                    android:id="@+id/spinnerLabel"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:background="#252830"
                    android:popupBackground="#161920" />

            </LinearLayout>

            <!-- Row 1: Follow + Approach -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnFollowHuman"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:backgroundTint="#00E5A0"
                    android:text="@string/follow_human"
                    android:textColor="#0D0F14"
                    android:textSize="11sp" />

                <Button
                    android:id="@+id/btnApproachHuman"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:backgroundTint="#0080FF"
                    android:text="@string/approach"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp" />

            </LinearLayout>

            <!-- Row 2: Snapshot + Find Human + Track -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnFindHuman"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:text="@string/find"
                    android:textSize="11sp"
                    android:backgroundTint="#252830"
                    android:textColor="#E8EAF0" />

                <Button
                    android:id="@+id/btnTrack"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:text="@string/track_object"
                    android:textSize="11sp"
                    android:backgroundTint="#252830"
                    android:textColor="#E8EAF0" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

    <!-- EMERGENCY STOP -->
    <Button
        android:id="@+id/btnEmergencyStop"
        android:layout_width="180dp"
        android:layout_height="180dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="17dp"
        android:backgroundTint="#E63946"
        android:contentDescription="@string/emergency_stop"
        android:elevation="12dp"
        android:stateListAnimator="@null"
        android:text="@string/stop_symbol"
        android:textColor="#FFFFFF"
        android:textSize="22sp"
        android:textStyle="bold" />

    <LinearLayout
        android:id="@+id/llEmergencyBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginBottom="220dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#CC1A1D24"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:visibility="gone"
        android:elevation="12dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/emergency_stopped_all_actions_halted"
            android:textColor="#FF6B6B"
            android:textStyle="bold"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnResetEstop"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:text="@string/reset"
            android:textSize="12sp"
            android:backgroundTint="#00E5A0"
            android:textColor="#0D0F14" />

    </LinearLayout>

</FrameLayout>